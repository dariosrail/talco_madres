# ===== Copia este archivo a .env (local) o captura estas variables en Railway =====

# Base de datos MySQL de SOADIN — usa UNA de las dos formas:
# a) URL completa (en Railway: referencia a la variable del servicio MySQL)
#    MYSQL_URL=${{MySQL.MYSQL_URL}}
# b) Datos sueltos
DB_HOST=tu-servidor-mysql.com
DB_PORT=3306
DB_USER=usuario
DB_PASSWORD=contraseña
DB_NAME=soadin

# Llave para firmar la sesión (pon una cadena larga y aleatoria)
SECRET_KEY=cambia-esto-por-algo-largo-y-secreto

# Datos que salen en el login y en el ticket
EMPRESA_NOMBRE=MI EMPRESA SA DE CV
EMPRESA_RFC=XAXX010101000
EMPRESA_DIRECCION=Calle 1 #100, Centro, Mérida, Yuc.
EMPRESA_TELEFONO=999 000 0000
# Opcional: URL pública del logo (png/jpg)
EMPRESA_LOGO_URL=

# 1 = cookie solo por https (Railway). Pon 0 si pruebas en tu red local sin https.
COOKIE_SEGURA=1
